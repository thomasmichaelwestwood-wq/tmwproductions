# ─── Twilio credentials ────────────────────────────────────────────────────
# Found at: https://console.twilio.com → Account Info panel

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The WhatsApp-enabled number on your Twilio account.
# Sandbox: whatsapp:+14155238886 (Twilio's shared sandbox number)
# Production: whatsapp:+44xxxxxxxxxx (your approved WhatsApp Business number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Business info ─────────────────────────────────────────────────────────
# Used in the sign-off of the WhatsApp message.
BUSINESS_NAME=TMW Productions

# ─── Webhook security ──────────────────────────────────────────────────────
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank to disable secret checking during local development.
WEBHOOK_SECRET=your_random_secret_here

# ─── Consent log ───────────────────────────────────────────────────────────
# Path for the consent audit log. Defaults to /tmp/consent-log.json in
# serverless environments (ephemeral). For production, switch to a
# persistent store and remove this variable.
# CONSENT_LOG_PATH=/tmp/consent-log.json

# ─── Supplier directory — Jotform ──────────────────────────────────────────
# API key for fetching submissions (sync script + GitHub Actions).
# Get it from: jotform.com/myaccount/api
JOTFORM_API_KEY=

# Shared secret for the /api/jotform-webhook endpoint.
# Jotform sends this as ?secret=... in the webhook URL.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOTFORM_WEBHOOK_SECRET=

# ─── Supplier directory — GitHub (real-time webhook commits) ───────────────
# The webhook function uses the GitHub API to commit updated supplier data
# so Netlify auto-deploys it immediately. Without these, new suppliers will
# appear at the next daily sync instead (3am UTC via GitHub Actions).
#
# Create a fine-grained PAT at: github.com/settings/tokens
# Required permission: Contents → Read and write
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=tmwproductions
GITHUB_BRANCH=main
